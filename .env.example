# Leave DATABASE_URL empty for local dev: the app falls back to an embedded
# PGlite database stored in ./.data/pickleball. Set it to a Postgres connection
# string for staging/production (required in production).
DATABASE_URL=

# HS256 secret used to sign the session cookie. Required in production.
SESSION_SECRET=

# Set to "false" to skip seeding demo courts/users/sessions in development.
SEED_DEMO_DATA=true

# Shared code the TV/monitor board asks for before it will display anything.
# Leave empty to make /display open to anyone on the network.
DISPLAY_ACCESS_CODE=
